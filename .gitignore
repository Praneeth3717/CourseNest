# ==========================================
# Frontend (Vite + React)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example

# ==========================================
# Backend (FastAPI + Python)
# ==========================================
backend/venv/
backend/.venv/
backend/env/
backend/__pycache__/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.env
backend/.env.*
!backend/.env.example

# Uploads
backend/uploads/*
!backend/uploads/.gitkeep

# Unignore the directories
!backend/uploads/certificates/
!backend/uploads/courses/
!backend/uploads/students/
!backend/uploads/teachers/

# Ignore everything inside them
backend/uploads/certificates/*
backend/uploads/courses/*
backend/uploads/students/*
backend/uploads/teachers/*

# Except .gitkeep
!backend/uploads/certificates/.gitkeep
!backend/uploads/courses/.gitkeep
!backend/uploads/students/.gitkeep
!backend/uploads/teachers/.gitkeep

# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ==========================================
# Logs
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==========================================
# IDE
# ==========================================
.vscode/
.idea/

# ==========================================
# OS
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# Coverage / Cache
# ==========================================
coverage/
.cache/
.pytest_cache/
.mypy_cache/

# ==========================================
# Misc
# ==========================================
*.swp
*.swo